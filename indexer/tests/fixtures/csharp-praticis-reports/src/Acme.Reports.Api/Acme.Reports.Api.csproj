<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>acme-reports-api</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <PackageReference Include="Scrutor" Version="7.0.0" />
    </ItemGroup>

    <!-- In-house SDK comes from the private NuGet feed: no ProjectReference crosses repositories,
         only versioned package dependencies. The provider's contracts are a dependency of .Core. -->
    <ItemGroup>
        <PackageReference Include="Acme.Shared.Api.Response" Version="1.0.0" />
        <PackageReference Include="Acme.Shared.Bus.Abstractions" Version="1.0.0" />
        <PackageReference Include="Acme.Shared.Bus.Core" Version="1.0.0" />
        <PackageReference Include="Acme.Shared.Bus.Kafka" Version="1.0.0" />
        <PackageReference Include="Acme.Shared.Data.MongoDB" Version="1.0.0" />
        <PackageReference Include="Acme.Shared.Interop" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Acme.Reports.Core\Acme.Reports.Core.csproj" />
        <ProjectReference Include="..\Acme.Reports.Contracts\Acme.Reports.Contracts.csproj" />
    </ItemGroup>

</Project>
